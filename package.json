{
  "name": "rpgonline",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
